    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"raw\",\n",
    "   \"source\": [\n",
    "    \"{\\n\",\n",
    "    \" \\\"cells\\\": [\\n\",\n",
    "    \"  {\\n\",\n",
    "    \"   \\\"metadata\\\": {},\\n\",\n",
    "    \"   \\\"cell_type\\\": \\\"code\\\",\\n\",\n",
    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"# ==============================================================================\\\\n\\\",\\n\",\n",
    "    \"    \\\"# ENHANCED PIPELINE - Saves both full frames and cropped classifications\\\\n\\\",\\n\",\n",
    "    \"    \\\"# ==============================================================================\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"import os\\\\n\\\",\\n\",\n",
    "    \"    \\\"import cv2\\\\n\\\",\\n\",\n",
    "    \"    \\\"import json\\\\n\\\",\\n\",\n",
    "    \"    \\\"from datetime import datetime\\\\n\\\",\\n\",\n",
    "    \"    \\\"from ultralytics import YOLO\\\\n\\\",\\n\",\n",
    "    \"    \\\"from tqdm.notebook import tqdm\\\\n\\\",\\n\",\n",
    "    \"    \\\"from dataclasses import dataclass, field, asdict\\\\n\\\",\\n\",\n",
    "    \"    \\\"from typing import List, Optional, Dict, Set\\\\n\\\",\\n\",\n",
    "    \"    \\\"from enum import Enum\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"class FilterMode(Enum):\\\\n\\\",\\n\",\n",
    "    \"    \\\"    ALL = \\\\\\\"all\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    INCLUDE = \\\\\\\"include\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    EXCLUDE = \\\\\\\"exclude\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"@dataclass\\\\n\\\",\\n\",\n",
    "    \"    \\\"class PipelineConfig:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    model_detect_path: str = 'data/model/detect_yolo_small_v8.pt'\\\\n\\\",\\n\",\n",
    "    \"    \\\"    model_classify_path: str = 'data/model/classify_yolo_small_v6.pt'\\\\n\\\",\\n\",\n",
    "    \"    \\\"    video_path: str = ''\\\\n\\\",\\n\",\n",
    "    \"    \\\"    output_base_dir: Optional[str] = None\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Detection settings\\\\n\\\",\\n\",\n",
    "    \"    \\\"    detection_confidence: float = 0.7\\\\n\\\",\\n\",\n",
    "    \"    \\\"    detection_filter_mode: FilterMode = FilterMode.ALL\\\\n\\\",\\n\",\n",
    "    \"    \\\"    detection_filter_classes: List[str] = field(default_factory=list)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Classification settings\\\\n\\\",\\n\",\n",
    "    \"    \\\"    classification_confidence: float = 0.5\\\\n\\\",\\n\",\n",
    "    \"    \\\"    classification_filter_mode: FilterMode = FilterMode.ALL\\\\n\\\",\\n\",\n",
    "    \"    \\\"    classification_filter_classes: List[str] = field(default_factory=list)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Processing settings\\\\n\\\",\\n\",\n",
    "    \"    \\\"    frame_skip: int = 100\\\\n\\\",\\n\",\n",
    "    \"    \\\"    min_crop_size: int = 5\\\\n\\\",\\n\",\n",
    "    \"    \\\"    save_format: str = \\\\\\\"jpg\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    save_quality: int = 95\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\n\\\",\\n\",\n",
    "    \"    \\\"    # ⭐ NEW: Frame saving options\\\\n\\\",\\n\",\n",
    "    \"    \\\"    save_full_frames: bool = True           # Save the complete frame\\\\n\\\",\\n\",\n",
    "    \"    \\\"    save_crops: bool = True                  # Save cropped classifications\\\\n\\\",\\n\",\n",
    "    \"    \\\"    draw_boxes_on_frame: bool = False         # Draw bounding boxes on saved frames\\\\n\\\",\\n\",\n",
    "    \"    \\\"    box_thickness: int = 2                   # Bounding box line thickness\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Metadata\\\\n\\\",\\n\",\n",
    "    \"    \\\"    save_metadata: bool = True\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Debug settings\\\\n\\\",\\n\",\n",
    "    \"    \\\"    debug_mode: bool = False\\\\n\\\",\\n\",\n",
    "    \"    \\\"    debug_max_frames: int = 500\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\n\\\",\\n\",\n",
    "    \"    \\\"    def __post_init__(self):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if self.output_base_dir is None and self.video_path:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            video_dir = os.path.dirname(self.video_path)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            self.output_base_dir = os.path.join(video_dir, 'output')\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"class DetectClassifyPipeline:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    Output Structure:\\\\n\\\",\\n\",\n",
    "    \"    \\\"    output/\\\\n\\\",\\n\",\n",
    "    \"    \\\"    └── Detection/\\\\n\\\",\\n\",\n",
    "    \"    \\\"        └── [detect_class_name]/\\\\n\\\",\\n\",\n",
    "    \"    \\\"            ├── Pure/                    # Full frames with this detection class\\\\n\\\",\\n\",\n",
    "    \"    \\\"            │   ├── 0001.jpg\\\\n\\\",\\n\",\n",
    "    \"    \\\"            │   └── 0002.jpg\\\\n\\\",\\n\",\n",
    "    \"    \\\"            └── Classes/\\\\n\\\",\\n\",\n",
    "    \"    \\\"                └── [classify_class_name]/  # Cropped & classified objects\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    ├── 0001.jpg\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    └── 0002.jpg\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Colors for bounding boxes (BGR format)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    COLORS = [\\\\n\\\",\\n\",\n",
    "    \"    \\\"        (0, 255, 0),    # Green\\\\n\\\",\\n\",\n",
    "    \"    \\\"        (255, 0, 0),    # Blue\\\\n\\\",\\n\",\n",
    "    \"    \\\"        (0, 0, 255),    # Red\\\\n\\\",\\n\",\n",
    "    \"    \\\"        (255, 255, 0),  # Cyan\\\\n\\\",\\n\",\n",
    "    \"    \\\"        (255, 0, 255),  # Magenta\\\\n\\\",\\n\",\n",
    "    \"    \\\"        (0, 255, 255),  # Yellow\\\\n\\\",\\n\",\n",
    "    \"    \\\"        (128, 0, 255),  # Purple\\\\n\\\",\\n\",\n",
    "    \"    \\\"        (255, 128, 0),  # Orange\\\\n\\\",\\n\",\n",
    "    \"    \\\"    ]\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\n\\\",\\n\",\n",
    "    \"    \\\"    def __init__(self, config: PipelineConfig):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        self.config = config\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Counters for sequential naming\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Structure: {detect_class: {classify_class: count}} for crops\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Structure: {detect_class: count} for pure frames\\\\n\\\",\\n\",\n",
    "    \"    \\\"        self.crop_counters: Dict[str, Dict[str, int]] = {}\\\\n\\\",\\n\",\n",
    "    \"    \\\"        self.frame_counters: Dict[str, int] = {}\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Track which frames we've already saved per detection class\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # to avoid saving the same frame multiple times\\\\n\\\",\\n\",\n",
    "    \"    \\\"        self.saved_frames: Dict[str, Set[int]] = {}\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        self.metadata_log: List[Dict] = []\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Debug stats\\\\n\\\",\\n\",\n",
    "    \"    \\\"        self.debug_stats = {\\\\n\\\",\\n\",\n",
    "    \"    \\\"            'frames_processed': 0,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            'total_detections': 0,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            'filtered_by_detection_class': 0,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            'filtered_by_crop_size': 0,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            'filtered_by_classification_confidence': 0,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            'filtered_by_classification_class': 0,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            'frames_saved': 0,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            'crops_saved': 0,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            'save_failures': 0,\\\\n\\\",\\n\",\n",
    "    \"    \\\"        }\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Load models\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(\\\\\\\"🔧 Loading YOLO models...\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        self.model_detect = YOLO(config.model_detect_path)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        self.model_classify = YOLO(config.model_classify_path, task='classify')\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        self.detect_names = self.model_detect.names\\\\n\\\",\\n\",\n",
    "    \"    \\\"        self.classify_names = self.model_classify.names\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Get color mapping for detection classes\\\\n\\\",\\n\",\n",
    "    \"    \\\"        self.class_colors = {\\\\n\\\",\\n\",\n",
    "    \"    \\\"            name: self.COLORS[idx % len(self.COLORS)] \\\\n\\\",\\n\",\n",
    "    \"    \\\"            for idx, name in self.detect_names.items()\\\\n\\\",\\n\",\n",
    "    \"    \\\"        }\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        self._print_config()\\\\n\\\",\\n\",\n",
    "    \"    \\\"        self._setup_directories()\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\n\\\",\\n\",\n",
    "    \"    \\\"    def _print_config(self):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(\\\\\\\"\\\\\\\\n\\\\\\\" + \\\\\\\"=\\\\\\\"*60)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(\\\\\\\"📋 PIPELINE CONFIGURATION\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(\\\\\\\"=\\\\\\\"*60)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(\\\\\\\"\\\\\\\\n📦 Detection classes available:\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        for idx, name in self.detect_names.items():\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(f\\\\\\\"   {idx}: '{name}'\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(\\\\\\\"\\\\\\\\n🏷️  Classification classes available:\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        for idx, name in self.classify_names.items():\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(f\\\\\\\"   {idx}: '{name}'\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"\\\\\\\\n⚙️  Filter Settings:\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"   Detection mode: {self.config.detection_filter_mode.value}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"   Detection classes: {self.config.detection_filter_classes or 'ALL'}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"   Detection confidence: {self.config.detection_confidence}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"   Classification mode: {self.config.classification_filter_mode.value}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"   Classification classes: {self.config.classification_filter_classes or 'ALL'}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"   Classification confidence: {self.config.classification_confidence}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"\\\\\\\\n💾 Save Settings:\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"   Save full frames: {self.config.save_full_frames}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"   Save crops: {self.config.save_crops}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"   Draw boxes on frames: {self.config.draw_boxes_on_frame}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"\\\\\\\\n📁 Output Structure:\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"   {self.config.output_base_dir}/\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"   └── Detection/\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"       └── [detect_class]/\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"           ├── Pure/          # Full frames\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"           └── Classes/\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"               └── [classify_class]/  # Crops\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\n\\\",\\n\",\n",
    "    \"    \\\"    def _setup_directories(self):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\\\\"\\\\\\\"\\\\\\\"Create output directory structure.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        os.makedirs(self.config.output_base_dir, exist_ok=True)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Test write access\\\\n\\\",\\n\",\n",
    "    \"    \\\"        test_file = os.path.join(self.config.output_base_dir, '_test.tmp')\\\\n\\\",\\n\",\n",
    "    \"    \\\"        try:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            with open(test_file, 'w') as f:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                f.write('test')\\\\n\\\",\\n\",\n",
    "    \"    \\\"            os.remove(test_file)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(f\\\\\\\"\\\\\\\\n✅ Output directory ready: {self.config.output_base_dir}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        except Exception as e:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(f\\\\\\\"\\\\\\\\n❌ OUTPUT DIRECTORY NOT WRITABLE: {e}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\n\\\",\\n\",\n",
    "    \"    \\\"    def _get_pure_frame_path(self, detect_class: str) -> str:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\\\\"\\\\\\\"\\\\\\\"Get path for saving full frame under detection class.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Structure: output/Detection/[detect_class]/Pure/0001.jpg\\\\n\\\",\\n\",\n",
    "    \"    \\\"        pure_dir = os.path.join(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            self.config.output_base_dir,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            \\\\\\\"Detection\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"            detect_class,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            \\\\\\\"Pure\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        )\\\\n\\\",\\n\",\n",
    "    \"    \\\"        os.makedirs(pure_dir, exist_ok=True)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Initialize counter if needed\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if detect_class not in self.frame_counters:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            self.frame_counters[detect_class] = 1\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        base = os.path.splitext(os.path.basename(self.config.video_path))[0]\\\\n\\\",\\n\",\n",
    "    \"    \\\"        filename = f\\\\\\\"{base}_{self.frame_counters[detect_class]:04d}.{self.config.save_format}\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        self.frame_counters[detect_class] += 1\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        return os.path.join(pure_dir, filename)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\n\\\",\\n\",\n",
    "    \"    \\\"    def _get_crop_path(self, detect_class: str, classify_class: str) -> str:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\\\\"\\\\\\\"\\\\\\\"Get path for saving cropped classification.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Structure: output/Detection/[detect_class]/Classes/[classify_class]/0001.jpg\\\\n\\\",\\n\",\n",
    "    \"    \\\"        crop_dir = os.path.join(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            self.config.output_base_dir,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            \\\\\\\"Detection\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"            detect_class,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            \\\\\\\"Classes\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"            classify_class\\\\n\\\",\\n\",\n",
    "    \"    \\\"        )\\\\n\\\",\\n\",\n",
    "    \"    \\\"        os.makedirs(crop_dir, exist_ok=True)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Initialize counters if needed\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if detect_class not in self.crop_counters:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            self.crop_counters[detect_class] = {}\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if classify_class not in self.crop_counters[detect_class]:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            self.crop_counters[detect_class][classify_class] = 1\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        filename = f\\\\\\\"{self.crop_counters[detect_class][classify_class]:04d}.{self.config.save_format}\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        self.crop_counters[detect_class][classify_class] += 1\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        return os.path.join(crop_dir, filename)\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\n\\\",\\n\",\n",
    "    \"    \\\"    def _should_process_detection(self, class_name: str) -> bool:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        mode = self.config.detection_filter_mode\\\\n\\\",\\n\",\n",
    "    \"    \\\"        filter_classes = self.config.detection_filter_classes\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        if mode == FilterMode.ALL:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            return True\\\\n\\\",\\n\",\n",
    "    \"    \\\"        elif mode == FilterMode.INCLUDE:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            return class_name in filter_classes\\\\n\\\",\\n\",\n",
    "    \"    \\\"        elif mode == FilterMode.EXCLUDE:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            return class_name not in filter_classes\\\\n\\\",\\n\",\n",
    "    \"    \\\"        return True\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\n\\\",\\n\",\n",
    "    \"    \\\"    def _should_save_classification(self, class_name: str, confidence: float) -> tuple:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\\\\"\\\\\\\"\\\\\\\"Returns (should_save, reason_if_not)\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if confidence < self.config.classification_confidence:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            return False, f\\\\\\\"confidence {confidence:.3f} < {self.config.classification_confidence}\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        mode = self.config.classification_filter_mode\\\\n\\\",\\n\",\n",
    "    \"    \\\"        filter_classes = self.config.classification_filter_classes\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        if mode == FilterMode.ALL:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            return True, \\\\\\\"\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        elif mode == FilterMode.INCLUDE:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            if class_name in filter_classes:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                return True, \\\\\\\"\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"            return False, f\\\\\\\"'{class_name}' not in {filter_classes}\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        elif mode == FilterMode.EXCLUDE:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            if class_name not in filter_classes:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                return True, \\\\\\\"\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"            return False, f\\\\\\\"'{class_name}' is excluded\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        return True, \\\\\\\"\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\n\\\",\\n\",\n",
    "    \"    \\\"    def _save_image(self, path: str, image) -> bool:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\\\\"\\\\\\\"\\\\\\\"Save image with error handling.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        try:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            if self.config.save_format == \\\\\\\"jpg\\\\\\\":\\\\n\\\",\\n\",\n",
    "    \"    \\\"                success = cv2.imwrite(path, image, \\\\n\\\",\\n\",\n",
    "    \"    \\\"                    [cv2.IMWRITE_JPEG_QUALITY, self.config.save_quality])\\\\n\\\",\\n\",\n",
    "    \"    \\\"            else:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                success = cv2.imwrite(path, image)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            \\\\n\\\",\\n\",\n",
    "    \"    \\\"            if not success:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                print(f\\\\\\\"❌ cv2.imwrite failed: {path}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"                self.debug_stats['save_failures'] += 1\\\\n\\\",\\n\",\n",
    "    \"    \\\"                return False\\\\n\\\",\\n\",\n",
    "    \"    \\\"            return True\\\\n\\\",\\n\",\n",
    "    \"    \\\"            \\\\n\\\",\\n\",\n",
    "    \"    \\\"        except Exception as e:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(f\\\\\\\"❌ Save error: {e}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"            self.debug_stats['save_failures'] += 1\\\\n\\\",\\n\",\n",
    "    \"    \\\"            return False\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\n\\\",\\n\",\n",
    "    \"    \\\"    def _draw_boxes_on_frame(self, frame, detections_info: List[Dict]):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\\\\"\\\\\\\"\\\\\\\"Draw bounding boxes and labels on frame.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        frame_copy = frame.copy()\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        for det in detections_info:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            x1, y1, x2, y2 = det['bbox']\\\\n\\\",\\n\",\n",
    "    \"    \\\"            detect_class = det['detect_class']\\\\n\\\",\\n\",\n",
    "    \"    \\\"            classify_class = det['classify_class']\\\\n\\\",\\n\",\n",
    "    \"    \\\"            classify_conf = det['classify_conf']\\\\n\\\",\\n\",\n",
    "    \"    \\\"            \\\\n\\\",\\n\",\n",
    "    \"    \\\"            color = self.class_colors.get(detect_class, (0, 255, 0))\\\\n\\\",\\n\",\n",
    "    \"    \\\"            \\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Draw rectangle\\\\n\\\",\\n\",\n",
    "    \"    \\\"            cv2.rectangle(frame_copy, (x1, y1), (x2, y2), color, self.config.box_thickness)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            \\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Create label\\\\n\\\",\\n\",\n",
    "    \"    \\\"            label = f\\\\\\\"{classify_class} ({classify_conf:.2f})\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"            \\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Get label size for background\\\\n\\\",\\n\",\n",
    "    \"    \\\"            font = cv2.FONT_HERSHEY_SIMPLEX\\\\n\\\",\\n\",\n",
    "    \"    \\\"            font_scale = 0.5\\\\n\\\",\\n\",\n",
    "    \"    \\\"            thickness = 1\\\\n\\\",\\n\",\n",
    "    \"    \\\"            (label_w, label_h), baseline = cv2.getTextSize(label, font, font_scale, thickness)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            \\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Draw label background\\\\n\\\",\\n\",\n",
    "    \"    \\\"            cv2.rectangle(frame_copy,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                         (x1, y1 - label_h - 10),\\\\n\\\",\\n\",\n",
    "    \"    \\\"                         (x1 + label_w + 5, y1),\\\\n\\\",\\n\",\n",
    "    \"    \\\"                         color, -1)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            \\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Draw label text\\\\n\\\",\\n\",\n",
    "    \"    \\\"            cv2.putText(frame_copy, label, \\\\n\\\",\\n\",\n",
    "    \"    \\\"                       (x1 + 2, y1 - 5), \\\\n\\\",\\n\",\n",
    "    \"    \\\"                       font, font_scale, (255, 255, 255), thickness)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        return frame_copy\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\n\\\",\\n\",\n",
    "    \"    \\\"    def process_frame(self, frame, frame_number: int) -> Dict[str, int]:\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        Process a single frame.\\\\n\\\",\\n\",\n",
    "    \"    \\\"        Returns dict with counts: {'frames_saved': n, 'crops_saved': m}\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if frame is None:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            return {'frames_saved': 0, 'crops_saved': 0}\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        self.debug_stats['frames_processed'] += 1\\\\n\\\",\\n\",\n",
    "    \"    \\\"        results = {'frames_saved': 0, 'crops_saved': 0}\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Run detection\\\\n\\\",\\n\",\n",
    "    \"    \\\"        results_detect = self.model_detect(\\\\n\\\",\\n\",\n",
    "    \"    \\\"            frame, \\\\n\\\",\\n\",\n",
    "    \"    \\\"            conf=self.config.detection_confidence, \\\\n\\\",\\n\",\n",
    "    \"    \\\"            verbose=False\\\\n\\\",\\n\",\n",
    "    \"    \\\"        )\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        if not results_detect or not results_detect[0].boxes:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            return results\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        detections = results_detect[0].boxes\\\\n\\\",\\n\",\n",
    "    \"    \\\"        self.debug_stats['total_detections'] += len(detections)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Group detections by detection class\\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Structure: {detect_class: [list of detection info]}\\\\n\\\",\\n\",\n",
    "    \"    \\\"        detections_by_class: Dict[str, List[Dict]] = {}\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        if self.config.debug_mode:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(f\\\\\\\"\\\\\\\\n🎬 Frame {frame_number}: {len(detections)} detections\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        for idx, box in enumerate(detections):\\\\n\\\",\\n\",\n",
    "    \"    \\\"            detect_class_id = int(box.cls[0])\\\\n\\\",\\n\",\n",
    "    \"    \\\"            detect_class_name = self.detect_names[detect_class_id]\\\\n\\\",\\n\",\n",
    "    \"    \\\"            detect_confidence = float(box.conf[0])\\\\n\\\",\\n\",\n",
    "    \"    \\\"            \\\\n\\\",\\n\",\n",
    "    \"    \\\"            if self.config.debug_mode:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                print(f\\\\\\\"   [{idx}] Detected: '{detect_class_name}' (conf: {detect_confidence:.3f})\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"            \\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Filter by detection class\\\\n\\\",\\n\",\n",
    "    \"    \\\"            if not self._should_process_detection(detect_class_name):\\\\n\\\",\\n\",\n",
    "    \"    \\\"                self.debug_stats['filtered_by_detection_class'] += 1\\\\n\\\",\\n\",\n",
    "    \"    \\\"                if self.config.debug_mode:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    print(f\\\\\\\"      ⏭️  Skipped: detection class filter\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"                continue\\\\n\\\",\\n\",\n",
    "    \"    \\\"            \\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Get bounding box and crop\\\\n\\\",\\n\",\n",
    "    \"    \\\"            x1, y1, x2, y2 = map(int, box.xyxy[0])\\\\n\\\",\\n\",\n",
    "    \"    \\\"            x1, y1 = max(0, x1), max(0, y1)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            x2, y2 = min(frame.shape[1], x2), min(frame.shape[0], y2)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            \\\\n\\\",\\n\",\n",
    "    \"    \\\"            crop_img = frame[y1:y2, x1:x2]\\\\n\\\",\\n\",\n",
    "    \"    \\\"            \\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Validate crop size\\\\n\\\",\\n\",\n",
    "    \"    \\\"            if (crop_img.size == 0 or \\\\n\\\",\\n\",\n",
    "    \"    \\\"                crop_img.shape[0] < self.config.min_crop_size or \\\\n\\\",\\n\",\n",
    "    \"    \\\"                crop_img.shape[1] < self.config.min_crop_size):\\\\n\\\",\\n\",\n",
    "    \"    \\\"                self.debug_stats['filtered_by_crop_size'] += 1\\\\n\\\",\\n\",\n",
    "    \"    \\\"                if self.config.debug_mode:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    print(f\\\\\\\"      ⏭️  Skipped: crop too small\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"                continue\\\\n\\\",\\n\",\n",
    "    \"    \\\"            \\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Run classification\\\\n\\\",\\n\",\n",
    "    \"    \\\"            results_classify = self.model_classify(crop_img, verbose=False)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            \\\\n\\\",\\n\",\n",
    "    \"    \\\"            classify_class_id = results_classify[0].probs.top1\\\\n\\\",\\n\",\n",
    "    \"    \\\"            classify_class_name = self.classify_names[classify_class_id]\\\\n\\\",\\n\",\n",
    "    \"    \\\"            classify_confidence = float(results_classify[0].probs.top1conf)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            \\\\n\\\",\\n\",\n",
    "    \"    \\\"            if self.config.debug_mode:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                print(f\\\\\\\"      🏷️  Classified: '{classify_class_name}' (conf: {classify_confidence:.3f})\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"            \\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Filter by classification\\\\n\\\",\\n\",\n",
    "    \"    \\\"            should_save, reason = self._should_save_classification(classify_class_name, classify_confidence)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            if not should_save:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                if classify_confidence < self.config.classification_confidence:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    self.debug_stats['filtered_by_classification_confidence'] += 1\\\\n\\\",\\n\",\n",
    "    \"    \\\"                else:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    self.debug_stats['filtered_by_classification_class'] += 1\\\\n\\\",\\n\",\n",
    "    \"    \\\"                if self.config.debug_mode:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    print(f\\\\\\\"      ⏭️  Skipped: {reason}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"                continue\\\\n\\\",\\n\",\n",
    "    \"    \\\"            \\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Store detection info\\\\n\\\",\\n\",\n",
    "    \"    \\\"            det_info = {\\\\n\\\",\\n\",\n",
    "    \"    \\\"                'bbox': [x1, y1, x2, y2],\\\\n\\\",\\n\",\n",
    "    \"    \\\"                'detect_class': detect_class_name,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                'detect_conf': detect_confidence,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                'classify_class': classify_class_name,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                'classify_conf': classify_confidence,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                'crop_img': crop_img,\\\\n\\\",\\n\",\n",
    "    \"    \\\"            }\\\\n\\\",\\n\",\n",
    "    \"    \\\"            \\\\n\\\",\\n\",\n",
    "    \"    \\\"            if detect_class_name not in detections_by_class:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                detections_by_class[detect_class_name] = []\\\\n\\\",\\n\",\n",
    "    \"    \\\"            detections_by_class[detect_class_name].append(det_info)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Now save frames and crops organized by detection class\\\\n\\\",\\n\",\n",
    "    \"    \\\"        for detect_class, det_list in detections_by_class.items():\\\\n\\\",\\n\",\n",
    "    \"    \\\"            \\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Initialize saved frames tracking\\\\n\\\",\\n\",\n",
    "    \"    \\\"            if detect_class not in self.saved_frames:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                self.saved_frames[detect_class] = set()\\\\n\\\",\\n\",\n",
    "    \"    \\\"            \\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Save full frame (once per detection class per frame)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            if self.config.save_full_frames:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                if frame_number not in self.saved_frames[detect_class]:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    \\\\n\\\",\\n\",\n",
    "    \"    \\\"                    if self.config.draw_boxes_on_frame:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                        frame_to_save = self._draw_boxes_on_frame(frame, det_list)\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    else:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                        frame_to_save = frame\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    \\\\n\\\",\\n\",\n",
    "    \"    \\\"                    frame_path = self._get_pure_frame_path(detect_class)\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    \\\\n\\\",\\n\",\n",
    "    \"    \\\"                    if self._save_image(frame_path, frame_to_save):\\\\n\\\",\\n\",\n",
    "    \"    \\\"                        results['frames_saved'] += 1\\\\n\\\",\\n\",\n",
    "    \"    \\\"                        self.debug_stats['frames_saved'] += 1\\\\n\\\",\\n\",\n",
    "    \"    \\\"                        self.saved_frames[detect_class].add(frame_number)\\\\n\\\",\\n\",\n",
    "    \"    \\\"                        \\\\n\\\",\\n\",\n",
    "    \"    \\\"                        if self.config.debug_mode:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                            print(f\\\\\\\"      💾 Saved frame: {frame_path}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"            \\\\n\\\",\\n\",\n",
    "    \"    \\\"            # Save crops\\\\n\\\",\\n\",\n",
    "    \"    \\\"            if self.config.save_crops:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                for det_info in det_list:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    crop_path = self._get_crop_path(\\\\n\\\",\\n\",\n",
    "    \"    \\\"                        detect_class, \\\\n\\\",\\n\",\n",
    "    \"    \\\"                        det_info['classify_class']\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    )\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    \\\\n\\\",\\n\",\n",
    "    \"    \\\"                    if self._save_image(crop_path, det_info['crop_img']):\\\\n\\\",\\n\",\n",
    "    \"    \\\"                        results['crops_saved'] += 1\\\\n\\\",\\n\",\n",
    "    \"    \\\"                        self.debug_stats['crops_saved'] += 1\\\\n\\\",\\n\",\n",
    "    \"    \\\"                        \\\\n\\\",\\n\",\n",
    "    \"    \\\"                        if self.config.debug_mode:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                            print(f\\\\\\\"      💾 Saved crop: {crop_path}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    \\\\n\\\",\\n\",\n",
    "    \"    \\\"                    # Log metadata\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    if self.config.save_metadata:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                        self.metadata_log.append({\\\\n\\\",\\n\",\n",
    "    \"    \\\"                            'frame': frame_number,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                            'crop_file': crop_path,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                            'detection_class': det_info['detect_class'],\\\\n\\\",\\n\",\n",
    "    \"    \\\"                            'detection_confidence': round(det_info['detect_conf'], 4),\\\\n\\\",\\n\",\n",
    "    \"    \\\"                            'classification_class': det_info['classify_class'],\\\\n\\\",\\n\",\n",
    "    \"    \\\"                            'classification_confidence': round(det_info['classify_conf'], 4),\\\\n\\\",\\n\",\n",
    "    \"    \\\"                            'bbox': det_info['bbox']\\\\n\\\",\\n\",\n",
    "    \"    \\\"                        })\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        return results\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\n\\\",\\n\",\n",
    "    \"    \\\"    def process_video(self):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\\\\"\\\\\\\"\\\\\\\"Process the entire video.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if not os.path.exists(self.config.video_path):\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(f\\\\\\\"❌ ERROR: Video not found: {self.config.video_path}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"            return\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        cap = cv2.VideoCapture(self.config.video_path)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if not cap.isOpened():\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(f\\\\\\\"❌ ERROR: Could not open video: {self.config.video_path}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"            return\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        frame_count = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\\\\n\\\",\\n\",\n",
    "    \"    \\\"        fps = cap.get(cv2.CAP_PROP_FPS)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"\\\\\\\\n🎥 Video: {os.path.basename(self.config.video_path)}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"   Frames: {frame_count} | FPS: {fps:.2f}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"   Processing every {self.config.frame_skip} frames\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        print(f\\\\\\\"   Estimated frames to process: {frame_count // self.config.frame_skip}\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        if self.config.debug_mode:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(f\\\\\\\"   🐛 DEBUG MODE: Stopping after {self.config.debug_max_frames} frames\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        total_frames_saved = 0\\\\n\\\",\\n\",\n",
    "    \"    \\\"        total_crops_saved = 0\\\\n\\\",\\n\",\n",
    "    \"    \\\"        frame_number = 0\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        max_frames = self.config.debug_max_frames if self.config.debug_mode else frame_count\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        with tqdm(total=min(frame_count, max_frames), desc=\\\\\\\"Processing\\\\\\\") as pbar:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            while cap.isOpened():\\\\n\\\",\\n\",\n",
    "    \"    \\\"                ret, frame = cap.read()\\\\n\\\",\\n\",\n",
    "    \"    \\\"                if not ret:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    break\\\\n\\\",\\n\",\n",
    "    \"    \\\"                \\\\n\\\",\\n\",\n",
    "    \"    \\\"                frame_number += 1\\\\n\\\",\\n\",\n",
    "    \"    \\\"                pbar.update(1)\\\\n\\\",\\n\",\n",
    "    \"    \\\"                \\\\n\\\",\\n\",\n",
    "    \"    \\\"                if self.config.debug_mode and frame_number > self.config.debug_max_frames:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    print(f\\\\\\\"\\\\\\\\n🛑 Debug mode: Stopping after {self.config.debug_max_frames} frames\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    break\\\\n\\\",\\n\",\n",
    "    \"    \\\"                \\\\n\\\",\\n\",\n",
    "    \"    \\\"                if frame_number % self.config.frame_skip != 0:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    continue\\\\n\\\",\\n\",\n",
    "    \"    \\\"                \\\\n\\\",\\n\",\n",
    "    \"    \\\"                result = self.process_frame(frame, frame_number)\\\\n\\\",\\n\",\n",
    "    \"    \\\"                total_frames_saved += result['frames_saved']\\\\n\\\",\\n\",\n",
    "    \"    \\\"                total_crops_saved += result['crops_saved']\\\\n\\\",\\n\",\n",
    "    \"    \\\"                \\\\n\\\",\\n\",\n",
    "    \"    \\\"                pbar.set_postfix({\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    'frames': total_frames_saved, \\\\n\\\",\\n\",\n",
    "    \"    \\\"                    'crops': total_crops_saved\\\\n\\\",\\n\",\n",
    "    \"    \\\"                })\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        cap.release()\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"        # Save metadata\\\\n\\\",\\n\",\n",
    "    \"    \\\"        if self.config.save_metadata and self.metadata_log:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            metadata_path = os.path.join(self.config.output_base_dir, 'metadata.json')\\\\n\\\",\\n\",\n",
    "    \"    \\\"            with open(metadata_path, 'w') as f:\\\\n\\\",\\n\",\n",
    "    \"    \\\"                json.dump({\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    'config': asdict(self.config),\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    'crops': self.metadata_log,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    'frame_counts': self.frame_counters,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    'crop_counts': self.crop_counters,\\\\n\\\",\\n\",\n",
    "    \"    \\\"                    'debug_stats': self.debug_stats,\\\\n\\\",\\n\",\n",
